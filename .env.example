# Copy this file to .env and fill in real values. .env is git-ignored.
# Only the variables actually used by code that exists so far are listed;
# more are added here as each later task (W-A2, W-M2, W-A3/A4) lands.

# W-A2 (provider layer): which adapter a run uses. A run is all one adapter,
# never mixed automatically.
MODELBENCH_ADAPTER=bedrock  # bedrock | anthropic_direct | openai_compatible | azure_foundry

# W-A2 (Bedrock adapter): AWS region and credentials for an IAM user scoped
# to Bedrock invoke only.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# W-A2 (fallback adapters), only needed if MODELBENCH_ADAPTER is not bedrock.
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Section 6.2 (Azure AI Foundry -- the second provider): only needed if
# MODELBENCH_ADAPTER=azure_foundry. Endpoint and deployment come from the
# Foundry project the owner provisions at Gate 1 (section 4: project
# "giggit-foundry", one small chat-completions deployment). None of these
# exist yet -- as of this comment, `az account show` fails because the
# Azure CLI itself is not installed on this Mac.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
# Optional -- defaults to a plausible-but-UNVERIFIED Azure REST api-version
# string in azure_foundry.py (see that file's module docstring). Confirm the
# real value against the Foundry deployment's own docs page at Gate 1 and
# set it here if it differs.
AZURE_FOUNDRY_API_VERSION=

# W-M1 (web/tests/schema.test.js): a scratch PostgreSQL 16 database to run
# api/meter/schema.sql's real DDL against. NOT a production secret — no
# live data lives here, it's dropped and recreated by the test itself.
# CI sets this against a postgres:16 service container; without it the
# schema tests are skipped (not silently passed) with a message saying
# so. See README.md's "Testing the cost-meter schema" for how to start
# one locally.
TEST_DATABASE_URL=

# W-M2 (not yet wired — the meter's live database, used once api/meter/store.js
# stops reading fixtures/usage_events.fixture.json).
DATABASE_URL=
